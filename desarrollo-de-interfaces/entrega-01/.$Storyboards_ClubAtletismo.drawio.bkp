        <mxCell id="n647" value="&lt;b&gt;RULE / LOGIC ·&lt;/b&gt; The empty state explains why there are no results and offers a way out." style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFF7CC;strokeColor=#C9A000;strokeWidth=1.6;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=13;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=34;spacingRight=10;" vertex="1" parent="1">
