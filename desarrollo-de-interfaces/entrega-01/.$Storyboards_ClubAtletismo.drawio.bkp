  <diagram id="story06" name="06 · Coach · AthleteProfileNotes">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="&lt;b&gt;STORY 06&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#111111;strokeColor=none;strokeWidth=1.5;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="40" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Coach · Athlete profile and notes" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=40;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="38" width="2600" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="“As a coach, I want to view the profile page of one of the athletes I coach and add notes to it.”" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=24;fontColor=#374151;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="1500" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="What this storyboard shows" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=17;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="175" width="1500" height="23" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="• The coach only reaches athletes of the assigned teams (list → profile)." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="204" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="• The profile shows sport data; sensitive medical data is hidden from coaches." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="231" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="• Adding a note: category, text and visibility (private by default), then confirmation." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="258" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="• Error / edge states: search with no results and a note saved without category or text." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="285" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1.5;" vertex="1" parent="1">
