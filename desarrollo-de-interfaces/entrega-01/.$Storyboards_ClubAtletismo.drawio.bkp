        </mxCell>
        <mxCell id="n4" value="“As a club owner, I want to create a user with a specific role (athlete, coach, staff, admin).”" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=24;fontColor=#374151;fontStyle=2;" vertex="1" parent="1">
