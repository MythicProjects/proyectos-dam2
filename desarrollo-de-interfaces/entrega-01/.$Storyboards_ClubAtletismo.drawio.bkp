        <mxCell id="n5" value="What this storyboard shows" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=17;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="175" width="1500" height="23" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="• Read: the user list is the hub; Create, Update and Delete always return to it with feedback." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="204" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="• Create: role chosen with 4 explicit options; the Team field depends on the role." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="231" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="• Update and Delete from the user page; Delete is isolated, red and needs confirmation." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
