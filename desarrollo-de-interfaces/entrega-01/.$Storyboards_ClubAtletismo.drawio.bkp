        <mxCell id="n3" value="Club owner · Create and manage users (CRUD)" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=40;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
