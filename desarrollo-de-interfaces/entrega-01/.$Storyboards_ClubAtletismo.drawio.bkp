        <mxCell id="n4" value="“As a coach, I want to view my calendar of events (training sessions and matches) for my assigned teams, with detailed information of each event.”" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=24;fontColor=#374151;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="1500" height="63" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="What this storyboard shows" style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=17;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="175" width="1500" height="23" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="• Calendar limited to the coach’s assigned teams; event types are told apart by fill and label." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="204" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="• Clicking / tapping an event opens its details: training, competition or cancelled event." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="158" y="231" width="1480" height="21" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="• Desktop uses a week grid with a side panel; mobile uses an agenda list with full-screen details." style="text;html=1;whiteSpace=wrap;overflow=visible;spacing=0;align=left;verticalAlign=top;fontFamily=Work Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DWork%2BSans;fontSize=16;fontColor=#374151;fontStyle=0;" vertex="1" parent="1">
